# Environment Variables for Overkill Memory System
# Copy this file to .env and fill in your values

# ===========================================
# CORE CONFIGURATION
# ===========================================

# ChromaDB Configuration
CHROMA_URL=http://localhost:8100

# Ollama Configuration (for embeddings)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=bge-m3

# ===========================================
# CLOUD INTEGRATIONS (OPTIONAL - Requires API keys)
# ===========================================

# Mem0 API Key (for auto-fact extraction)
# Get your key from https://mem0.ai
# Required only if using Mem0 cloud features
MEM0_API_KEY=m0-kiEp1bxln3ev5jq5qjHsIF4fBLHBEelwGqDydqVo

# Supermemory API Key (for cloud backup)
# Get your key from https://supermemory.ai
# Required only if using Supermemory cloud backup
SUPERMEMORY_API_KEY=sm_j7cKDbh6fpapLD6e2gPkAg_nuYjNaLmPsiwnECdbMJTXTZbloupMHRIUcvOycQwlbwhfNEKSEsbAqeuqpMxShHq

# Mem0 Local Mode (set to "true" to use local Ollama instead of cloud)
# If true, MEM0_API_KEY is not required
MEM0_USE_LOCAL=true

# ===========================================
# REDIS CONFIGURATION (OPTIONAL)
# ===========================================

# Redis for hot cache (optional - will fallback to in-memory if not available)
REDIS_URL=localhost:6379
