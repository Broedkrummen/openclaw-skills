{
  "name": "brave-api-search-plugin",
  "version": "1.0.0",
  "description": "Native OpenClaw tools for Brave Search, Autosuggest, Spellcheck and AI Answers.",
  "author": "Broedkrummen",
  "license": "MIT-0",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "formatters.js",
    "schemas.js",
    "openclaw.plugin.json",
    "README.md",
